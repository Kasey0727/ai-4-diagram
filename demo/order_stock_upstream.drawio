<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" version="26.0.0" type="device">
  <diagram id="upstream-order-stock" name="订单创建与库存校验">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="940">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pool" value="订单创建与库存校验" style="swimlane;html=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=15;" vertex="1" parent="1">
