          <mxGeometry x="0" y="30" width="1650" height="230" as="geometry" />
        </mxCell>
        <mxCell id="lane-order" value="订单服务" style="swimlane;html=1;startSize=30;horizontal=0;collapsible=0;fillColor=none;strokeColor=#999999;fontSize=14;" vertex="1" parent="pool">
          <mxGeometry x="0" y="260" width="1650" height="230" as="geometry" />
        </mxCell>
        <mxCell id="lane-inventory" value="库存服务" style="swimlane;html=1;startSize=30;horizontal=0;collapsible=0;fillColor=none;strokeColor=#999999;fontSize=14;" vertex="1" parent="pool">
