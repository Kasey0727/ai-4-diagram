        <mxCell id="e-success" value="订单创建成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="return-success" target="show-success"><mxGeometry relative="1" as="geometry" /></mxCell>
