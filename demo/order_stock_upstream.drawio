        <mxCell id="e-no" value="否：返回库存不足" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#b85450;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="stock-decision" target="show-failure"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="290" /><mxPoint x="1085" y="290" /></Array></mxGeometry></mxCell>
