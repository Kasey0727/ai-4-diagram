        <mxCell id="e-submit" value="提交订单请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="submit" target="validate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-query" value="查询库存" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="validate" target="query-stock"><mxGeometry relative="1" as="geometry" /></mxCell>
