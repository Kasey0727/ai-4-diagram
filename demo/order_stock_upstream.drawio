        <mxCell id="legend-decision" value="条件判断" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="150" y="30" width="120" height="22" as="geometry" /></mxCell>
        <mxCell id="legend-failure" value="失败分支" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="285" y="30" width="120" height="22" as="geometry" /></mxCell>
        <mxCell id="legend-end" value="开始 / 成功" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="15" y="65" width="120" height="22" as="geometry" /></mxCell>
