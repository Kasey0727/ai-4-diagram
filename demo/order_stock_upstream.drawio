        </mxCell>
        <mxCell id="submit" value="提交订单" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;strokeWidth=2;" vertex="1" parent="lane-client">
          <mxGeometry x="80" y="45" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="校验订单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;strokeWidth=2;" vertex="1" parent="lane-order">
          <mxGeometry x="300" y="45" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="query-stock" value="查询库存" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;strokeWidth=2;" vertex="1" parent="lane-inventory">
          <mxGeometry x="520" y="45" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="stock-decision" value="库存充足？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;strokeWidth=2;" vertex="1" parent="lane-order">
          <mxGeometry x="740" y="70" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="create" value="创建订单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;strokeWidth=2;" vertex="1" parent="lane-order">
          <mxGeometry x="960" y="45" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="return-success" value="返回成功" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;strokeWidth=2;" vertex="1" parent="lane-order">
          <mxGeometry x="1180" y="45" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="show-success" value="展示成功" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;strokeWidth=2;" vertex="1" parent="lane-client">
          <mxGeometry x="1400" y="45" width="170" height="60" as="geometry" />
