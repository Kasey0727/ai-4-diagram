<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" version="26.0.0" type="device">
  <diagram id="order-stock-text2drawio-vertical" name="订单创建与库存校验">
    <mxGraphModel dx="1280" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1500">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pool" value="订单创建与库存校验" style="swimlane;html=1;horizontal=1;startSize=40;collapsible=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1200" height="1420" as="geometry" />
        </mxCell>
        <mxCell id="lane-client" value="客户端" style="swimlane;html=1;horizontal=1;startSize=40;collapsible=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="pool">
          <mxGeometry x="0" y="40" width="330" height="1380" as="geometry" />
        </mxCell>
        <mxCell id="lane-order" value="订单服务" style="swimlane;html=1;horizontal=1;startSize=40;collapsible=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="pool">
          <mxGeometry x="330" y="40" width="540" height="1380" as="geometry" />
        </mxCell>
        <mxCell id="lane-inventory" value="库存服务" style="swimlane;html=1;horizontal=1;startSize=40;collapsible=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="pool">
          <mxGeometry x="870" y="40" width="330" height="1380" as="geometry" />
        </mxCell>

        <mxCell id="submit" value="提交订单" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="lane-client">
          <mxGeometry x="85" y="90" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="校验订单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="lane-order">
          <mxGeometry x="170" y="200" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="request-stock" value="发起库存查询" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="lane-order">
          <mxGeometry x="170" y="350" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lookup-stock" value="查询并返回库存状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="lane-inventory">
          <mxGeometry x="70" y="500" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="stock-decision" value="库存充足？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="lane-order">
          <mxGeometry x="170" y="680" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="create-order" value="创建订单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="lane-order">
          <mxGeometry x="50" y="900" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="return-failure" value="返回失败：库存不足" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;strokeWidth=2;fontSize=14;" vertex="1" parent="lane-order">
          <mxGeometry x="310" y="900" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="return-success" value="返回成功" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="lane-order">
          <mxGeometry x="50" y="1050" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="show-success" value="展示成功" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=2;fontSize=13;" vertex="1" parent="lane-client">
          <mxGeometry x="30" y="1250" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="show-failure" value="展示“库存不足”" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;strokeWidth=2;fontSize=12;" vertex="1" parent="lane-client">
