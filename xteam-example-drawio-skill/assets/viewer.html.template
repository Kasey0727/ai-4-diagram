<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" href="data:,">
<title>__TITLE__</title>
<style>
  :root {
    --bg: #f6f7f9;
    --panel: #ffffff;
    --line: #e3e6eb;
    --ink: #1b1f24;
    --muted: #6b7280;
    --accent: #2f6feb;
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body {
    background: var(--bg);
    color: var(--ink);
    font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  header {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
  }
  .title {
    font-weight: 600;
    font-size: 14px;
    letter-spacing: .01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .meta { color: var(--muted); font-size: 12px; white-space: nowrap; }
  .spacer { flex: 1 1 auto; }
  .tools { display: flex; align-items: center; gap: 6px; }
  button {
    appearance: none;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--ink);
    height: 30px;
    min-width: 30px;
    padding: 0 10px;
    border-radius: 7px;
    font-size: 12px;
    white-space: nowrap;
    cursor: pointer;
    transition: background .12s ease, border-color .12s ease, color .12s ease;
  }
  button:hover { background: #f0f2f5; border-color: #d3d8df; }
  button:active { transform: translateY(.5px); }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  button.primary:hover { background: #2560d4; border-color: #2560d4; }
  .zoom {
    min-width: 52px;
    text-align: center;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    font-size: 12px;
    user-select: none;
  }
  #stage {
    position: relative;
    flex: 1 1 auto;
    overflow: hidden;
    cursor: grab;
    background-image: radial-gradient(#dfe3e9 1px, transparent 1px);
    background-size: 20px 20px;
    touch-action: none;
  }
  #stage.dragging { cursor: grabbing; }
  /* A zero-size container makes the diagrams.net viewer skip rendering,
     so the viewport must always have a measurable box. */
  #viewport {
    position: absolute;
    inset: 0;
    transform-origin: 0 0;
    will-change: transform;
  }
  #viewport > svg { display: block; background: transparent; }
  #viewport .mxgraph { background: transparent !important; }
  #viewport .mxgraph svg { display: block; background: transparent !important; }
  .hint {
    position: absolute;
    left: 14px;
    bottom: 12px;
    color: var(--muted);
    font-size: 12px;
    background: rgba(255,255,255,.86);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 3px 8px;
    pointer-events: none;
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%) translateY(12px);
    background: #1b1f24;
    color: #fff;
    font-size: 12px;
    padding: 7px 12px;
    border-radius: 7px;
    opacity: 0;
    pointer-events: none;
    transition: opacity .18s ease, transform .18s ease;
    z-index: 20;
  }
  .toast.show { opacity: .94; transform: translateX(-50%) translateY(0); }
  @media (max-width: 640px) {
    .meta { display: none; }
    .title { max-width: 34vw; }
    header { gap: 6px; padding: 8px 10px; }
    button { padding: 0 7px; font-size: 11px; }
    .zoom { min-width: 40px; }
    .hint { display: none; }
  }
</style>
</head>
<body>
<header>
  <span class="title" title="__TITLE__">__TITLE__</span>
  <span class="meta">__DRAWIO_NAME__</span>
  <span class="spacer"></span>
  <div class="tools">
    <button id="zoomOut" title="缩小" aria-label="缩小">&minus;</button>
    <span class="zoom" id="zoomLabel">100%</span>
    <button id="zoomIn" title="放大" aria-label="放大">+</button>
    <button id="fit" title="适应窗口" aria-label="适应窗口">适应</button>
    <button id="download" class="primary" title="下载 .drawio 文件">下载 .drawio</button>
    <button id="fullscreen" title="全屏" aria-label="全屏">全屏</button>
  </div>
</header>

<div id="stage">
  <div id="viewport">__CANVAS_HTML__</div>
  <div class="hint">拖拽平移 · 滚轮缩放 · 双击适应窗口</div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(function () {
  "use strict";

  var MXFILE = __MXFILE_JSON__;
  var FILE_NAME = __DRAWIO_NAME_JSON__;

  var stage = document.getElementById("stage");
  var viewport = document.getElementById("viewport");
  var zoomLabel = document.getElementById("zoomLabel");
  var toastEl = document.getElementById("toast");

  var scale = 1, tx = 0, ty = 0;
  var naturalW = 0, naturalH = 0;

  function applyTransform() {
    viewport.style.transform = "translate(" + tx + "px," + ty + "px) scale(" + scale + ")";
    zoomLabel.textContent = Math.round(scale * 100) + "%";
  }

  function toast(msg) {
    toastEl.textContent = msg;
    toastEl.classList.add("show");
    clearTimeout(toast._t);
    toast._t = setTimeout(function () { toastEl.classList.remove("show"); }, 1600);
  }

  function measure() {
    var svg = viewport.querySelector("svg");
    if (!svg) return false;
    var box = svg.getBoundingClientRect();
    naturalW = Math.max(box.width / (scale || 1), 1);
    naturalH = Math.max(box.height / (scale || 1), 1);
    return true;
  }

  function fit(padding) {
    var svg = viewport.querySelector("svg");
    if (!svg) return;
    var box = stage.getBoundingClientRect();
    var vb = svg.viewBox && svg.viewBox.baseVal;
    var w = (vb && vb.width) ? vb.width : (naturalW || box.width);
    var h = (vb && vb.height) ? vb.height : (naturalH || box.height);
    var pad = padding == null ? 36 : padding;
    scale = Math.min((box.width - pad * 2) / w, (box.height - pad * 2) / h);
    scale = Math.max(0.05, Math.min(scale, 3));
    tx = (box.width - w * scale) / 2;
    ty = (box.height - h * scale) / 2;
    applyTransform();
  }

  function zoomAt(next, cx, cy) {
    next = Math.max(0.05, Math.min(next, 8));
    var box = stage.getBoundingClientRect();
    var px = cx == null ? box.width / 2 : cx;
    var py = cy == null ? box.height / 2 : cy;
    tx = px - (px - tx) * (next / scale);
    ty = py - (py - ty) * (next / scale);
    scale = next;
    applyTransform();
  }

  var dragging = false, lastX = 0, lastY = 0;
  stage.addEventListener("pointerdown", function (e) {
    if (e.button !== 0) return;
    dragging = true;
    lastX = e.clientX; lastY = e.clientY;
    stage.classList.add("dragging");
    if (stage.setPointerCapture) stage.setPointerCapture(e.pointerId);
  });
  stage.addEventListener("pointermove", function (e) {
    if (!dragging) return;
    tx += e.clientX - lastX;
    ty += e.clientY - lastY;
    lastX = e.clientX; lastY = e.clientY;
    applyTransform();
  });
  function endPan(e) {
    if (!dragging) return;
    dragging = false;
    stage.classList.remove("dragging");
    if (stage.hasPointerCapture && stage.hasPointerCapture(e.pointerId)) {
      stage.releasePointerCapture(e.pointerId);
    }
  }
  stage.addEventListener("pointerup", endPan);
  stage.addEventListener("pointercancel", endPan);

  stage.addEventListener("wheel", function (e) {
    e.preventDefault();
    var box = stage.getBoundingClientRect();
    zoomAt(scale * Math.pow(1.0015, -e.deltaY), e.clientX - box.left, e.clientY - box.top);
  }, { passive: false });

  stage.addEventListener("dblclick", function (e) {
    if (e.target.closest("button")) return;
    fit();
  });

  document.getElementById("zoomIn").addEventListener("click", function () { zoomAt(scale * 1.2); });
  document.getElementById("zoomOut").addEventListener("click", function () { zoomAt(scale / 1.2); });
  document.getElementById("fit").addEventListener("click", function () { fit(); });
  document.getElementById("fullscreen").addEventListener("click", function () {
    if (document.fullscreenElement) { document.exitFullscreen(); }
    else if (stage.requestFullscreen) { stage.requestFullscreen(); }
  });
  document.addEventListener("fullscreenchange", function () { setTimeout(function () { fit(); }, 60); });

  document.getElementById("download").addEventListener("click", function () {
    var blob = new Blob([MXFILE], { type: "application/xml;charset=utf-8" });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url;
    a.download = FILE_NAME;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    toast("已下载 " + FILE_NAME);
  });

  function boot() {
    if (!viewport.querySelector("svg")) {
      toast("图形未渲染，请刷新或检查网络");
      return;
    }
    measure();
    fit();
    setTimeout(measure, 150);
  }

  // Without this the diagram is stranded off-screen after a window resize
  // or a rotation, because the transform is in stage pixel space.
  var resizeTimer = null;
  window.addEventListener("resize", function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () { measure(); fit(); }, 120);
  });

  var tries = 0;
  var timer = setInterval(function () {
    tries++;
    if (viewport.querySelector("svg")) {
      clearInterval(timer);
      boot();
    } else if (tries > 150) {
      clearInterval(timer);
      toast("图形渲染超时，请检查网络后刷新");
    }
  }, 100);
})();
</script>
__VIEWER_SCRIPT__
</body>
</html>
